# Custom Creations Unlimited — hide source/build files from the public web
RedirectMatch 404 ^/scripts(/|$)
RedirectMatch 404 ^/\.git(/|$)
RedirectMatch 404 \.(py|sh|md)$
RedirectMatch 404 ^/CNAME$

# The blog was removed (2026-08-08). Point the old URLs at the closest service
# page rather than 404ing anything Google already has indexed; the catch-all
# must stay last so the specific rules win. All of them are RedirectMatch:
# mixing Redirect with RedirectMatch let the catch-all win on this server,
# and every post landed on the homepage instead.
RedirectMatch 301 ^/blog/embroidery-vs-screen-print-vs-dtf\.html$    /services/embroidery.html
RedirectMatch 301 ^/blog/build-a-uniform-program\.html$              /services/embroidery.html
RedirectMatch 301 ^/blog/awards-that-feel-earned\.html$              /services/awards.html
RedirectMatch 301 ^/blog/corporate-gifting-that-works\.html$         /services/personalized-gifts.html
RedirectMatch 301 ^/blog/promotional-products-worth-the-spend\.html$ /services/promotional-products.html
RedirectMatch 301 ^/blog/advantages-of-uv-printing\.html$            /services/custom-apparel.html
RedirectMatch 301 ^/blog(/.*)?$ /

# Caching. HTML carried no Cache-Control at all, so browsers fell back to
# heuristic caching and returning visitors could sit on a stale page for days
# after a deploy. HTML must always be revalidated; CSS/JS/media are safe to
# cache hard because every reference is versioned (?v=N) and a content change
# comes with a new version string.
# IfModule guards: if a module is missing the block is skipped rather than
# throwing a 500.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|webp|jpg|jpeg|png|svg|woff2|mp4|pdf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
